# EduTube Environment Configuration Template
# Copy this to .env.production and fill in your values
# DO NOT commit .env.production to git!

# ===== DATABASE CONFIGURATION =====
# PostgreSQL database connection
DATABASE_URL="postgresql://postgres:pgadmin@postgres:5432/Video_Portal_Dummy"

# ===== JWT CONFIGURATION =====
# Secret key for JWT tokens (change this to a strong random string!)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT token expiration time
JWT_EXPIRY="7d"

# ===== API CONFIGURATION =====
# Backend API URL (used by frontend)
# For local: http://localhost:5001
# For production: http://your-domain:5001 or internal IP
API_URL="http://localhost:5001"

# Frontend URL (used by backend for CORS)
# For local: http://localhost:3000
# For production: http://your-domain or https://your-domain
FRONTEND_URL="http://localhost:3000"

# ===== APPLICATION ENVIRONMENT =====
# Node environment
NODE_ENV="production"

# ===== REDIS CONFIGURATION =====
# Redis cache connection (optional)
REDIS_URL="redis://redis:6379"

# Redis database number
REDIS_DB="0"

# ===== ELASTICSEARCH CONFIGURATION =====
# Elasticsearch URL (optional, for search functionality)
ELASTICSEARCH_URL="http://elasticsearch:9200"

# ===== PORT CONFIGURATION =====
# Backend API port
PORT="5001"

# Frontend port (usually via reverse proxy)
FRONTEND_PORT="3000"

# PostgreSQL port (from docker-compose)
POSTGRES_PORT="5433"

# ===== LOGGING CONFIGURATION =====
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# ===== SESSION CONFIGURATION =====
# Session timeout in minutes
SESSION_TIMEOUT="60"

# Session secret (different from JWT secret)
SESSION_SECRET="your-session-secret-key"

# ===== CORS CONFIGURATION =====
# Allow requests from these origins
# Separate multiple with comma
CORS_ORIGINS="http://localhost:3000,http://localhost:5001"

# ===== FILE UPLOAD CONFIGURATION =====
# Maximum file upload size (in MB)
MAX_FILE_SIZE="100"

# Upload directory
UPLOAD_DIR="./uploads"

# ===== RATE LIMITING =====
# Rate limit window in minutes
RATE_LIMIT_WINDOW="15"

# Rate limit max requests per window
RATE_LIMIT_MAX="100"

# ===== CACHING =====
# Cache TTL in seconds
CACHE_TTL="3600"

# ===== EMAIL CONFIGURATION =====
# Email service (optional)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@edutube.com"

# ===== OPTIONAL: EXTERNAL SERVICES =====
# Analytics
# ANALYTICS_KEY="your-analytics-key"

# Error tracking (e.g., Sentry)
# SENTRY_DSN="https://your-sentry-dsn"

# Cloud storage (e.g., AWS S3)
# AWS_ACCESS_KEY_ID="your-key"
# AWS_SECRET_ACCESS_KEY="your-secret"
# AWS_REGION="us-east-1"
# S3_BUCKET="edutube-uploads"

# ===== OPTIONAL: OAUTH =====
# Google OAuth (for authentication)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft OAuth (optional)
# MICROSOFT_CLIENT_ID="your-microsoft-client-id"
# MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# ===== OPTIONAL: WEBHOOKS =====
# Webhook URLs for events
# WEBHOOK_URL="https://your-domain/webhooks"

# ===== DEBUG MODE =====
# Enable debug mode (NEVER in production!)
DEBUG="false"

# ===== PRODUCTION SECURITY =====
# Content Security Policy (CSP)
# CSP_HEADER="default-src 'self';"

# Enable HTTPS redirect
# HTTPS_REDIRECT="true"

# Security headers
# HSTS_MAX_AGE="31536000"

# ===== NOTES =====
# - Always use strong random values for secrets
# - Never share JWT_SECRET or SESSION_SECRET
# - Use HTTPS in production
# - Set DEBUG to false in production
# - Regularly rotate authentication keys
# - For Docker Compose, service names can be used as hostnames
#   (e.g., postgres:5432 instead of localhost:5432)
